export function errorHandler(err, _req, res, _next) {
  console.error('[Error]', err.message);

  const status = err.status || 500;
  const message =
    err.message?.includes('GEMINI_API_KEY')
      ? err.message
      : status === 500
        ? 'Internal server error'
        : err.message;

  res.status(status).json({ error: message });
}
